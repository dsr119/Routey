# Postgres connection string (Supabase gives you one under Project Settings > Database)
DATABASE_URL=postgres://postgres@localhost:5432/routey

# Set to true to let anyone create a new business at /setup.
# When false, /setup only works while the database has no businesses yet.
ALLOW_SIGNUP=false

# Google Maps key for checking addresses and optimizing routes (server side only)
GOOGLE_MAPS_API_KEY=

# The address this app is reached at, used in emailed pay links.
APP_URL=http://localhost:3000

# Stripe (use test keys, sk_test_..., until ready for real money)
STRIPE_SECRET_KEY=
# Signing secret for the webhook at <APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Email through Resend (resend.com). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Your Business <invoices@yourdomain.com>

# Invoice texts through Twilio. Only sent to clients marked "Text invoices".
# TWILIO_FROM is your Twilio number, like +15185550100. US numbers must be
# registered for business texting (A2P 10DLC) before carriers deliver them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
